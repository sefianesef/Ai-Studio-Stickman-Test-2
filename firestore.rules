rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security validation
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidWalletData(data) {
      return data.gems is int && data.gems >= 0 &&
             data.redGems is int && data.redGems >= 0 &&
             data.coins is int && data.coins >= 0;
    }

    // Strict validation for user profile / wallet updates:
    // - Removes loose continuous client-write (Case B +5 gems every 2s).
    // - Enforces session-based match-end sync with bounded gain delta and anti-spam cooldown.
    function validateUserUpdate(requestData, resourceData) {
      return isValidWalletData(requestData) &&
             requestData.isCheaterFlagged == resourceData.isCheaterFlagged &&
             (
               // Case A: Spending gems/coins or inventory purchase (balance decreases or stays equal)
               (requestData.gems <= resourceData.gems &&
                requestData.redGems <= resourceData.redGems &&
                requestData.coins <= resourceData.coins) ||
               // Case B: Match-End / Session-Based Sync reward increment (bounded delta <= 50 gems & 20s cooldown)
               (requestData.gems - resourceData.gems > 0 &&
                requestData.gems - resourceData.gems <= 50 &&
                request.time > resourceData.lastUpdated + duration.value(20, 's'))
             );
    }

    // 1. User Profiles & Cloud Wallet Document (users collection)
    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidWalletData(request.resource.data) &&
                       request.resource.data.gems <= 100 &&
                       request.resource.data.isCheaterFlagged == false;

      allow update: if isOwner(userId) &&
                       validateUserUpdate(request.resource.data, resource.data);

      allow delete: if false;

      match /transactions/{txId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         request.resource.data.amount is int &&
                         request.resource.data.timestamp == request.time;
        allow update, delete: if false;
      }
    }

    // 2. Player Profiles & Cloud Wallet Document (players collection)
    match /players/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidWalletData(request.resource.data) &&
                       request.resource.data.gems <= 100 &&
                       request.resource.data.isCheaterFlagged == false;

      allow update: if isOwner(userId) &&
                       validateUserUpdate(request.resource.data, resource.data);

      allow delete: if false;

      match /inventory/{slotId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
                                 request.resource.data.quantity is int &&
                                 request.resource.data.quantity >= 0;
        allow delete: if false;
      }

      match /transactions/{txId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         request.resource.data.amount is int &&
                         request.resource.data.timestamp == request.time;
        allow update, delete: if false;
      }
    }

    // 3. Global Leaderboard
    match /leaderboard/{entryId} {
      allow read: if true;
      allow create, update: if isAuthenticated() &&
                                request.resource.data.userId == request.auth.uid &&
                                request.resource.data.score is int &&
                                request.resource.data.score >= 0 &&
                                request.resource.data.score <= 10000 &&
                                request.resource.data.isCheater == false;
      allow delete: if false;
    }
  }
}
